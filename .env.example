# AION / Gemini API Configuration
AION_API_KEY=your_aion_api_key_here
AION_API_ENDPOINT=https://api.aion.xyz/v1/chat
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Database & Edge Functions
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here
